# .env.example: safe names only; real values stay out of Git. `make env` renders .env with generated secrets.
# Native dev (make dev) reaches the Compose services on these 127.0.0.1 host ports.
POSTGRES_USER=treadops
POSTGRES_PASSWORD=...
DATABASE_URL=postgresql+psycopg://treadops:...@127.0.0.1:55432/treadops
TEST_DATABASE_URL=postgresql+psycopg://treadops:...@127.0.0.1:55432/treadops_test
REDIS_URL=redis://127.0.0.1:56379/0
S3_ENDPOINT_URL=http://127.0.0.1:58333
S3_BUCKET=treadops
S3_ACCESS_KEY_ID=...                 # server-side only
S3_SECRET_ACCESS_KEY=...
MLFLOW_TRACKING_URI=http://127.0.0.1:55000
MLFLOW_UI_URL=                        # optional: browser-reachable MLflow for links (default: MLFLOW_TRACKING_URI)
LLM_MLFLOW_TRACING=true               # MLflow Tracing of Bib turns and the vision check (redacted; images omitted)
API_INTERNAL_URL=http://127.0.0.1:8000  # Next.js server only
JWT_SECRET=...                       # generated, not a fixed sample secret
JWT_ISSUER=treadops-api
JWT_AUDIENCE=treadops-web
APP_ORIGIN=http://localhost:3100
WEB_PORT=3100
MAX_UPLOAD_BYTES=8388608
MAX_DECODED_PIXELS=25000000
INFERENCE_QUEUE_LIMIT=100
TRAIN_DEVICE=cpu                     # override to 0 (CUDA) or mps (Apple) for training
DEMO_PASSWORD=...                    # seeded demo users (make seed-demo); fixture accounts only

# Copilot (OpenAI-compatible: OpenAI, Azure OpenAI, LiteLLM, vLLM, Ollama /v1 ...). Empty -> deterministic fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_RETRIES=2
MLFLOW_DISABLE_AGENT_HINT=1
MAX_INFLIGHT_UPLOADS=8              # per API process; excess uploads get 429 before the body is read
VISION_CHECK_MODEL=                   # optional vision model (same gateway) for the second opinion on auto-clears; images leave the network
ROBOFLOW_API_KEY=                     # optional: downloads the public tyre-damage datasets for the damage locator
